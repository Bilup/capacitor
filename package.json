{
  "name": "bilup-capacitor",
  "version": "2.0.3",
  "description": "Bilup Desktop Capacitor Version",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bilup/capacitor.git"
  },
  "author": {
    "email": "support@bilup.org",
    "name": "Bilup"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Bilup/capacitor/issues"
  },
  "homepage": "https://github.com/Bilup/capacitor#readme",
  "private": true,
  "scripts": {
    "prebuild": "npm run fetch:gui && npm run verify:lock && npm run build:gui && npm run verify:build && npm run cap:copy",
    "fetch:gui": "node scripts/fetch-scratch-gui.mjs",
    "verify:lock": "node scripts/verify-engine.mjs lock",
    "build:gui": "cd scratch-gui && pnpm install --frozen-lockfile && pnpm run build",
    "verify:build": "node scripts/verify-engine.mjs bundle scratch-gui/build",
    "verify:apk": "node scripts/verify-engine.mjs bundle",
    "pin:gui": "node scripts/pin-scratch-gui.mjs",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  }
}
